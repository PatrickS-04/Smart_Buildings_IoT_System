@page "/"
@inject IJSRuntime JS

<PageTitle>Sensor Dashboard</PageTitle>

<div class="dashboard">
    <h1>Building Telemetry</h1>

    <div class="filter-zones">
        <label for="zonefilter">View a Main Zone</label>
        <select id="zonefilter" class="form-control" @bind:after="OnZoneChanged" @bind="_selectedZone">
            <option value="">All Zones</option>
            @foreach (var zone in MainZones)
            {
                <option value="@zone">@zone</option>
            }
        </select>
    </div>

    <section class="kpi-grid" aria-label="Building summary">
        <div class="kpi-card">
            <p class="kpi-label">Sensors online</p>
            <p class="kpi-value">@CurrentSnapshot.SensorsOnline<span class="kpi-value-muted"> / @CurrentSnapshot.SensorsTotal</span></p>
        </div>
        <div class="kpi-card">
            <p class="kpi-label">Avg temperature</p>
            <p class="kpi-value">@CurrentSnapshot.AvgTemperature.ToString("0.0")°C</p>
        </div>
        <div class="kpi-card">
            <p class="kpi-label">Open alerts</p>
            <p class="kpi-value kpi-value-warn">@CurrentSnapshot.OpenAlerts</p>
        </div>
        <div class="kpi-card">
            <p class="kpi-label">Energy today</p>
            <p class="kpi-value">@CurrentSnapshot.EnergyTodayKwh.ToString("N0")<span class="kpi-value-muted"> kWh</span></p>
        </div>
    </section>

    <section class="status-section">
        <h2>Sensor status — @(_selectedZone == "" ? "All zones" : _selectedZone)</h2>
        <div class="status-legend">
            <span><i class="legend-dot" style="background:var(--status-ok)"></i>Online</span>
            <span><i class="legend-dot" style="background:var(--status-warn)"></i>Warning</span>
            <span><i class="legend-dot" style="background:var(--status-critical)"></i>Offline</span>
        </div>
        <div class="status-panel">
            <div class="status-groups">
                @foreach (var group in CurrentSnapshot.SubZoneStatuses)
                {
                    <div class="status-group">
                        <p class="status-group-name">@group.SubZoneName</p>
                        <div class="status-group-sensors">
                            @foreach (var sensor in group.Sensors)
                            {
                                <div class="sensor-status-chip" title="@group.SubZoneName — @sensor.Category @sensor.ShortId — @SeverityLabel(sensor.Severity)">
                                    <span class="status-dot @sensor.Severity"></span>
                                    <span class="sensor-status-label">@sensor.Category · @sensor.ShortId</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="metrics-section">
        <h2>Readings by category — @(_selectedZone == "" ? "All zones" : _selectedZone)</h2>
        <div class="metric-groups">
            @foreach (var group in BuildMetricGroups(CurrentSnapshot))
            {
                <div class="metric-group">
                    <p class="metric-group-name">@group.CategoryName</p>
                    <div class="metric-tiles">
                        @foreach (var metric in group.Metrics)
                        {
                            <div class="metric-tile">
                                <p class="metric-tile-label">@metric.Label</p>
                                <p class="metric-tile-value">@metric.Value</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="chart-section">
        <h2>Temperature trend, last 24h — @(_selectedZone == "" ? "All zones" : _selectedZone)</h2>
        <div class="chart-legend">
            @foreach (var series in CurrentSnapshot.TempSeries)
            {
                <span><i class="legend-dot" style="background:@series.Color"></i>@series.Label</span>
            }
        </div>
        <div class="chart-wrap">
            <canvas id="tempTrendChart"></canvas>
        </div>
    </section>

    <section class="chart-section">
        <h2>Energy use by @(_selectedZone == "" ? "floor" : "sub-zone"), today</h2>
        <div class="chart-wrap chart-wrap-short">
            <canvas id="floorEnergyChart"></canvas>
        </div>
    </section>

    <section class="alerts-section">
        <h2>Recent alerts</h2>
        <ul class="alert-list">
            @foreach (var alert in RecentAlerts)
            {
                <li class="alert-item">
                    <span class="status-dot @alert.Severity"></span>
                    <div class="alert-body">
                        <p class="alert-title">@alert.Title</p>
                        <p class="alert-meta">@alert.Location</p>
                    </div>
                    <span class="alert-time">@alert.TimeAgo</span>
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private static readonly string[] MainZones =
    {
        "Occupied Spaces", "Amenities and Public Areas", "Technical and Utility",
        "Facilities and Logistics", "Structural and Safety", "Exterior and Perimeter"
    };

    private readonly string[] _hourLabels =
        { "00:00", "03:00", "06:00", "09:00", "12:00", "15:00", "18:00", "21:00" };

    private record TempSeries(string Label, string Color, double[] Data);

    private record MetricValue(string Label, string Value);

    // Groups metric tiles under one of the 5 sensor category groups from
    // SensorRegistration.razor, so the dashboard's category breakdown lines
    // up with what a user actually registers a sensor as.
    private record MetricGroup(string CategoryName, MetricValue[] Metrics);

    // Severity matches the CSS classes on .status-dot: "" = online (green/teal),
    // "warn" = warning (amber), "critical" = offline/fault (red).
    private record SensorStatusItem(string Category, string ShortId, string Severity);

    // A room/sub-zone can contain more than one sensor (e.g. a CO2 sensor and
    // a motion sensor in the same office), so sensors are grouped under the
    // sub-zone they're deployed in rather than one entry per sub-zone.
    private record SubZoneStatus(string SubZoneName, SensorStatusItem[] Sensors);

    private record ZoneSnapshot(
        int SensorsOnline, int SensorsTotal, double AvgTemperature, int OpenAlerts, double EnergyTodayKwh,
        TempSeries[] TempSeries, string[] EnergyLabels, double[] EnergyData, SubZoneStatus[] SubZoneStatuses);

