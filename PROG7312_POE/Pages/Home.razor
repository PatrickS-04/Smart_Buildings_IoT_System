    // Placeholder per-zone data - once sensor registration and real telemetry
    // exist, replace this dictionary with data pulled from a shared service
    // (see explanation below the code).
    private readonly Dictionary<string, ZoneSnapshot> _zoneData = new()
    {
        [""] = new ZoneSnapshot(428, 450, 22.4, 3, 1240,
