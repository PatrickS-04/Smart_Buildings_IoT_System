@page "/sensorregistration"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Headers
@using PROG7312_POE.Shared.DTOs
@using PROG7312_POE.Shared
@inject HttpClient Http

<PageTitle>Sensor Registration</PageTitle>

<div class="registration">
    <h1>Sensor Registration</h1>

    <section class="register-sensor-form">
        <h2>Register a Sensor</h2>

        @if (!string.IsNullOrEmpty(_submitError))
        {
            <p class="submit-error">@_submitError</p>
        }

        <EditForm Model="_model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator/>

            <div class="form-grid">
                <div class="form-field">
                    <label for="deviceMacAddress">MAC Address / Unique Identifier</label>
                    <InputText id="deviceMacAddress" class="form-control" @bind-Value="_model.DeviceMacAddress" placeholder="AA:BB:CC:DD:EE:FF"/>
                    <ValidationMessage For="() => _model.DeviceMacAddress"/>
                </div>

                <div class="form-field">
                    <label for="mainzone">Main Zone</label>
                    <InputSelect id="mainzone" class="form-control" @bind-Value="_model.MainZone" @bind-Value:after="OnMainZoneChanged">
                        <option value="">Select a Main Zone</option>
                        @foreach (var mainZone in SensorCategorization.MainZones)
                        {
                            <option value="@mainZone">@mainZone</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.MainZone"/>
                </div>

                @if (!string.IsNullOrEmpty(_model.MainZone))
                {
                    <div class="form-field">
                        <label for="subzone">Sub Zone</label>
                        <InputSelect id="subzone" class="form-control" @bind-Value="_model.SubZone">
                            <option value="">Select a Sub-Zone</option>
                            @foreach (var subZone in CurrentSubZones)
                            {
                                <option value="@subZone">@subZone</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _model.SubZone"/>
                    </div>
                }

                <div class="form-field">
                    <label for="floor">Floor</label>
                    <InputText id="floor" class="form-control" @bind-Value="_model.Floor" placeholder="E.g. Ground Floor, Floor 3, Basement 1"/>
                    <ValidationMessage For="() => _model.Floor"/>
                </div>

                <div class="form-field">
                    <label for="roomOrArea">Room / Area (optional)</label>
                    <InputText id="roomOrArea" class="form-control" @bind-Value="_model.RoomOrArea" placeholder="E.g. Room 204, Bay 3, Rack A2 - leave blank for an open floor/area"/>
                    <ValidationMessage For="() => _model.RoomOrArea"/>
                </div>

                <div class="form-field">
                    <label for="category">Sensor Category</label>
                    <InputSelect id="category" class="form-control" @bind-Value="_model.Category" @bind-Value:after="OnCategoryChanged">
                        <option value="">Select a Category</option>
                        @foreach (var category in SensorCategorization.SensorCategories)
                        {
                            <option value="@category">@category</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.Category"/>
                </div>

                @if (!string.IsNullOrEmpty(_model.Category))
                {
                    <div class="form-field">
                        <label for="sensortype">Sensor Type</label>
                        <InputSelect id="sensortype" class="form-control" @bind-Value="_model.SensorType">
                            <option value="">Select a Sensor Type</option>
                            @foreach (var type in CurrentSensorTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _model.SensorType"/>
                    </div>
                }
            </div>

            <div class="form-field">
                <label for="attachments">Attach Configuration files, deployment photos, or hardware log files</label>
                <InputFile id="attachments" multiple class="form-control" @key="_fileInputKey" OnChange="OnFilesSelected"/>
                @if (_pendingFiles.Count > 0)
                {
                    <ul class="pending-files">
                        @foreach (var file in _pendingFiles)
                        {
                            <li>
                                @file.Name <span class="file-size">(@FormatBytes(file.Size))</span>
                                <button type="button" class="remove-pending-file" @onclick="() => _pendingFiles.Remove(file)">X</button>
                            </li>
                        }
                    </ul>
                }
            </div>
            <button type="submit" class="btn btn-primary submit-registration">Register Sensor</button>
        </EditForm>
    </section>

    <section class="registered-sensors-list">
        <h2>Registered Sensors <span class="registered-sensor-count">(@_registeredSensors.Count)</span></h2>

        @if (_isLoading)
        {
            <p class="empty-state">Loading Registered Sensors...</p>
        }
        else if (_registeredSensors.Count == 0)
        {
            <p class="empty-state">No sensors are registered yet. Add a Sensor by using the form above.</p>
        }
        else
        {
            <ul class="sensor-list">
                @foreach (var sensor in _registeredSensors)
                {
                    <li class="sensor-card">
                        <div class="sensor-card-header">
                            <span class="device-id">@sensor.Sensor.DeviceMacAddress</span>
                            <span class="category-badge @CategoryCssClass(sensor.Sensor.Category)">@sensor.Sensor.Category</span>
                        </div>
                        <p class="sensor-type">@sensor.Sensor.SensorType</p>
                        <p class="sensor-location">@sensor.Sensor.MainZone: @sensor.Sensor.SubZone — @LocationLabel(sensor.Sensor)</p>
                        @if (sensor.Attachments.Count > 0)
                        {
                            <ul class="attachment-list">
                                @foreach (var file in sensor.Attachments)
                                {
                                    <li>@file.NameOfFile <span class="file-size">(@FormatBytes(file.SizeOfFile))</span></li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="no-attachments">No files attached</p>
                        }
                        <button type="button" class="remove-btn" @onclick="() => RemoveSensor(sensor.Sensor.DeviceMacAddress)">Remove</button>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private string[] CurrentSensorTypes =>
        string.IsNullOrEmpty(_model.Category) ? Array.Empty<string>() : SensorCategorization.SensorTypesByCategory.GetValueOrDefault(_model.Category, Array.Empty<string>());

    private string[] CurrentSubZones =>
        string.IsNullOrEmpty(_model.MainZone) ? Array.Empty<string>() : SensorCategorization.SubZones.GetValueOrDefault(_model.MainZone, Array.Empty<string>());

    private class DisplayOfSensor
    {
        public SensorRegistrationDto Sensor { get; set; } = new();
        public List<AttachmentsForSensorsDto> Attachments { get; set; } = new();
    }

    private SensorRegistrationModel _model = new();
    private List<PendingAttachment> _pendingFiles = new();
    private Guid _fileInputKey = Guid.NewGuid();
    private readonly List<DisplayOfSensor> _registeredSensors = new();

    private bool _isLoading = true;
    private string? _submitError;

    protected override async Task OnInitializedAsync()
    {
        await LoadSensorsAsync();
    }

    private async Task LoadSensorsAsync()
    {
        _isLoading = true;
        try
        {
            var sensors = await Http.GetFromJsonAsync<List<SensorRegistrationDto>>("/api/sensors") ?? new();
            _registeredSensors.Clear();

            foreach (var sensor in sensors)
            {
                var sensorAttachments = await Http.GetFromJsonAsync<List<AttachmentsForSensorsDto>>($"/api/sensors/{sensor.DeviceMacAddress}/attachments") ?? new();
                _registeredSensors.Add(new DisplayOfSensor { Sensor = sensor, Attachments = sensorAttachments });
            }
        }
        catch (Exception exception)
        {
            _submitError = $"Could not load Registered Sensors: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        _submitError = null;

        try
        {
            var sensorRegistrationDto = new SensorRegistrationDto
            {
                DeviceMacAddress = _model.DeviceMacAddress,
                MainZone = _model.MainZone,
                SubZone = _model.SubZone,
                Floor = _model.Floor,
                RoomOrArea = _model.RoomOrArea,
                Category = _model.Category,
                SensorType = _model.SensorType
            };

            var response = await Http.PostAsJsonAsync("/api/sensors", sensorRegistrationDto);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                _submitError = error?.Error ?? $"Registration failed ({(int)response.StatusCode})";
                return;
            }

            if (_pendingFiles.Count > 0)
            {
                await UploadAttachmentsAsync(sensorRegistrationDto.DeviceMacAddress);
            }

            await LoadSensorsAsync();

            _model = new SensorRegistrationModel();
            _fileInputKey = Guid.NewGuid();
            _pendingFiles = new();
        }
        catch (Exception exception)
        {
            _submitError = $"Registration failed: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task UploadAttachmentsAsync(string deviceMacAddress)
    {
        using var content = new MultipartFormDataContent();

        foreach (var file in _pendingFiles)
        {
            var byteContent = new ByteArrayContent(file.Content);
            byteContent.Headers.ContentType = new MediaTypeHeaderValue(
                string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType);

            content.Add(byteContent, "attachedFiles", file.Name);
        }

        var response = await Http.PostAsync($"/api/sensors/{deviceMacAddress}/attachments", content);

        if (!response.IsSuccessStatusCode)
        {
            _submitError = "Sensor was registered but attaching files failed. You can try attaching them later";
        }
    }

    private async Task DeleteSensorAsync(string deviceMacAddress)
    {
        var response = await Http.DeleteAsync($"/api/sensors/{deviceMacAddress}");

        if (!response.IsSuccessStatusCode)
        {
            _submitError = "Failed to delete the sensor and its attachments";
        }
        else
        {
            await LoadSensorsAsync();
        }
    }

    private async Task RemoveSensor(string deviceMacAddress)
    {
        var response = await Http.DeleteAsync($"/api/sensors/{deviceMacAddress}");

        if (response.IsSuccessStatusCode)
        {
            _registeredSensors.RemoveAll(sensor => sensor.Sensor.DeviceMacAddress == deviceMacAddress);
        }
    }

    private static string CategoryCssClass(string category) => category switch
    {
        "Environmental" => "category-environmental",
        "Occupancy and Motion" => "category-occupancy",
        "Energy and Power Consumption" => "category-energy",
        "Safety and Security" => "category-safety",
        "Structural and Facility" => "category-structural",
        "Actuators and Controls" => "category-actuator",
        _ => ""
    };

    private static string LocationLabel(SensorRegistrationDto sensor) =>
        string.IsNullOrWhiteSpace(sensor.RoomOrArea)
            ? sensor.Floor
            : $"{sensor.Floor}, {sensor.RoomOrArea}";

    private void OnMainZoneChanged()
    {
        _model.SubZone = string.Empty;
    }

    private void OnCategoryChanged()
    {
        _model.SensorType = string.Empty;
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs events)
    {
        try
        {
            var newFiles = events.GetMultipleFiles(10);

            foreach (var file in newFiles)
            {
                if (_pendingFiles.Any(f => f.Name == file.Name && f.Size == file.Size))
                {
                    continue;
                }

                await using var fileStream = file.OpenReadStream(
                    maxAllowedSize: 10 * 1024 * 1024);

                using var memoryStream = new MemoryStream();

                await fileStream.CopyToAsync(memoryStream);

                _pendingFiles.Add(new PendingAttachment
                {
                    Name = file.Name,
                    ContentType = string.IsNullOrEmpty(file.ContentType)
                        ? "application/octet-stream" : file.ContentType,
                    Size = file.Size,
                    Content = memoryStream.ToArray()
                });
            }
        }
        catch (Exception exception)
        {
            _submitError = $"Could not read selected files: {exception.Message}";
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024.0:0.#} KB";
        }

        return $"{bytes / (1024.0 * 1024):0.#} MB";
    }

    private record ErrorResponse(string Error);

    private class SensorRegistrationModel
    {
        [Required(ErrorMessage = "Device MAC Address or Unique Identifier is required")]
        public string DeviceMacAddress { get; set; } = string.Empty;

        [Required(ErrorMessage = "Sensor Main Zone deployment is required")]
        public string MainZone { get; set; } = string.Empty;

        [Required(ErrorMessage = "Sensor Sub-Zone deployment is required")]
        public string SubZone { get; set; } = string.Empty;

        [Required(ErrorMessage = "Floor is required")]
        public string Floor { get; set; } = string.Empty;

        public string RoomOrArea { get; set; } = string.Empty;

        [Required(ErrorMessage = "Sensor Category is required")]
        public string Category { get; set; } = string.Empty;

        [Required(ErrorMessage = "Sensor Type is required")]
        public string SensorType { get; set; } = string.Empty;
    }

    private class PendingAttachment
    {
        public string Name { get; set; } = string.Empty;
        public string ContentType { get; set; } = string.Empty;
        public long Size { get; set; }
        public byte[] Content { get; set; } = Array.Empty<byte>();
    }
}